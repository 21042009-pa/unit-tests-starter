{
  "name": "aula05-testes-starter",
  "version": "1.0.0",
  "description": "Projeto base da Aula 05 - Testes Unitarios com Jest",
  "scripts": {
    "test": "jest",
    "test:unit": "jest api/__tests__/unit",
    "test:integration": "jest api/__tests__/integration",
    "test:e2e": "playwright test -c front-end/playwright.config.js",
    "test:e2e:headed": "playwright test -c front-end/playwright.config.js --headed",
    "test:e2e:ui": "playwright test -c front-end/playwright.config.js --ui --headed",
    "test:e2e:report": "playwright show-report front-end/playwright-report",
    "api": "node api/server.js",
    "front:html": "node front-end/html/server.js",
    "front:react": "npm --prefix front-end/react run dev",
    "postinstall": "npm --prefix front-end/react install"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/front-end/"
    ]
  }
}
